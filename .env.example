# Copy this file to .env (it is git-ignored).
# Point boto3 at the local AWS emulator (Moto) instead of real AWS.
# Remove AWS_ENDPOINT_URL and supply real credentials, and the same boto3 code talks to AWS.
# 127.0.0.1 (not 'localhost') avoids a slow IPv6 lookup on Windows.
AWS_ENDPOINT_URL=http://127.0.0.1:9324
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
